# usuario del panel admin, obligatorio (ej: admin). Solo se usa una vez, para
# crear el primer administrador en la base de datos si no existe ninguno —
# después el admin cambia su contraseña desde el panel y este valor deja de
# importar (ver README, sección Seguridad).
ADMIN_USER=admin
# hash de la contraseña INICIAL del panel admin, obligatorio. NO es la
# contraseña en texto plano. El valor de acá abajo es solo un EJEMPLO de
# formato (hash de "cambiar-esta-contrasena", publicado en este mismo repo
# público) — el servidor lo reconoce y se niega a crear el admin inicial
# con él, así que dejarlo tal cual deja el panel sin
# ningún administrador. Generá tu propio hash con
# `python3 servidor/generar_hash_admin.py` (ejecutado en tu propia máquina,
# no en el servidor de despliegue, para que quien despliega no vea la
# contraseña real) y pegá acá el resultado.
# Las comillas simples son OBLIGATORIAS: el hash lleva "$" como separador
# (pbkdf2_sha256$iteraciones$salt$hash) y Docker Compose interpola
# variables dentro de .env — sin comillas, cualquier "$" seguido de algo
# que parezca nombre de variable se reemplaza por texto vacío y corrompe
# el hash sin avisar (a veces sí, a veces no, según con qué letra empiece
# el salt/hash generado).
ADMIN_PASS_HASH='pbkdf2_sha256$600000$deec2f9628d2aec504107990557ae826$716dc1a2a52dc2ce925fc7ca9a369d1d13ef57f23b4105c3e623a5af647e6289'

DB_NAME=biblioteca
DB_USER=biblioteca
# cambia-esta-contrasena-de-db
DB_PASSWORD=
# cambia-esta-contrasena-de-root
MYSQL_ROOT_PASSWORD=

# opcional — ruta DENTRO del contenedor a un certificado CA para cifrar la
# conexión servidor→MySQL. Sin efecto mientras "db" y "servidor" compartan
# la red interna de Docker (caso por defecto de este repo, ver
# docker-compose.prod.yml); solo hace falta si la base de datos se aloja
# fuera de esa red (managed DB en la nube, otra máquina) — apuntarla al CA
# cert que dé el proveedor. Puede colocarse dentro de /certs (mismo volumen
# que monta TLS_CERTS_DIR abajo), ej: DB_SSL_CA=/certs/db-ca.pem
DB_SSL_CA=

# openssl rand -hex 32, obligatoria
SECRET_KEY=

# opcional — respaldo compartido de X-Kiosk-Key, solo para PCs que todavía no
# tienen su propia key (generada desde el panel, pestaña "PCs"). Vacío cierra
# ese respaldo y obliga a que cada PC tenga su key propia. openssl rand -hex 32
KIOSK_API_KEY=

# opcional, orígenes separados por coma (ej: https://panel.midominio.com) — vacío = sin acceso cross-origin (el panel se sirve desde el mismo origen que la API, así que no lo necesita por defecto)
CORS_ORIGINS=

# opcional, default 5 — intentos fallidos de /auth/login antes de bloquear temporalmente la IP
LOGIN_MAX_INTENTOS=
# opcional, default 15 — minutos de bloqueo tras exceder LOGIN_MAX_INTENTOS
LOGIN_BLOQUEO_MINUTOS=

# opcional, default 24 — horas de validez de un JWT de admin antes de expirar. Cambiar la
# contraseña (PUT /auth/password) también revoca de inmediato cualquier token emitido antes
# de ese cambio, sin esperar a que expire.
TOKEN_EXPIRE_HOURS=

# opcional, vacío por defecto — IPs separadas por coma de reverse proxies/túneles
# de confianza (ej: Cloudflare Tunnel) autorizados a añadir a X-Forwarded-For la
# IP real del cliente para el rate limiting de /auth/login. Se usa la IP más a la
# derecha del header que no sea uno de estos proxies (el resto lo controla el cliente). Dejar vacío si el
# servidor no está detrás de un proxy (si lo está y esto queda vacío, todas las
# conexiones legítimas comparten la IP del proxy y un solo atacante bloquea a
# todos los administradores).
TRUSTED_PROXIES=

# opcional, default 5000000 (5MB) — límite de tamaño de body para POST/PUT/PATCH en toda la API
MAX_BODY_SIZE_BYTES=
# opcional, default 100 — máximo de sesiones por lote en POST /sync
SYNC_MAX_SESIONES=
# opcional, default 30 — consultas por minuto y por IP a GET /estudiantes/{carnet}
# autenticadas con X-Kiosk-Key (el panel admin, con JWT, no tiene este límite).
# Evita que quien tenga una key de kiosko filtrada pueda barrer el espacio de
# carnets y extraer los datos de toda la población estudiantil.
ESTUDIANTES_MAX_LECTURAS_MIN=
# opcional, default 60 — escrituras por minuto y por IP a los endpoints autenticados
# con X-Kiosk-Key que dan de alta/editan estudiantes o reciben sync/estado/hardware
# (el panel admin, con JWT, no tiene este límite). En POST /sync, cada estudiante
# nuevo que se da de alta cuenta como una escritura más. Evita que quien tenga una
# key de kiosko filtrada pueda crear o editar fichas de estudiantes en masa.
KIOSKO_MAX_ESCRITURAS_MIN=

# opcional, default false (deshabilitado) — habilita /docs, /redoc y /openapi.json
# (documentación interactiva de la API, sin autenticación). Dejarlo apagado en
# producción; activarlo (true/1/yes) solo para desarrollo local o debugging puntual.
ENABLE_API_DOCS=

# opcional, default false (deshabilitado) — habilita GET /metrics (formato
# Prometheus: conteo y latencia de requests por endpoint/status, sin datos de
# negocio ni PII). Sin autenticación propia — si se activa en producción,
# restringir el acceso a nivel de red (firewall, o que el scraper de
# Prometheus sea el único que llegue a ese puerto/ruta).
ENABLE_METRICS=

# TLS entre los kioscos y este servidor (recomendado — sin esto, la PII de
# estudiantes y KIOSK_API_KEY viajan sin cifrar por la LAN, ver
# docs/desarrollo/despliegue.md sección TLS y servidor/scripts/generar_ca.sh).
# Rutas DENTRO del contenedor; docker-compose.prod.yml monta TLS_CERTS_DIR
# (host, default ./certs) en /certs. Dejar ambas vacías = HTTP plano.
TLS_CERT_PATH=
TLS_KEY_PATH=
# opcional, default ./certs — carpeta en el host con server.key/server.pem/ca.pem.
# NUNCA ca.key: se monta dentro del contenedor (ver servidor/scripts/generar_ca.sh)
TLS_CERTS_DIR=

# opcional, default false — ponerlo en true si el panel se publica por HTTPS
# a través de un proxy/túnel que termina TLS delante de este servidor (p. ej.
# Cloudflare Tunnel) y a este proceso le llega HTTP plano. Fuerza `Secure` en
# las cookies de sesión del panel y activa HSTS. Con TLS_CERT_PATH/TLS_KEY_PATH
# rellenas no hace falta. Ojo: con esto activo, el login del panel por
# http://<ip-lan>:8000 deja de funcionar (el navegador descarta cookies
# `Secure` recibidas por HTTP) — entrar siempre por la URL HTTPS del proxy.
BEHIND_HTTPS_PROXY=
